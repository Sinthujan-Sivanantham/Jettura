{
    "rewrites": [
        {
            "source": "/api-gds/:match*",
            "destination": "https://test.api.amadeus.com/:match*"
        },
        {
            "source": "/api-travel/:match*",
            "destination": "https://api.travelpayouts.com/:match*"
        },
        {
            "source": "/api-duffel/:match*",
            "destination": "https://api.duffel.com/:match*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}